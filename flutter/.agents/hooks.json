{
  "qa-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./.agents/scripts/check-qa-approval.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "no-force-push": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./.agents/scripts/block-force-push.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
